rules_version = '2';

// Storage Security Rules are OR-based across matching path patterns: if any
// `match` block grants access, access is granted. A trailing
// `match /{allPaths=**} { allow read: if request.auth != null; }` therefore
// *cannot* be a fallback — it silently overrides every stricter rule above it.
// This file previously ended with exactly that, which meant any signed-in user
// could read every case scan in the system.
//
// There is deliberately no catch-all here. Anything without an explicit rule
// below is denied by default. Adding a new storage prefix means adding a rule.

service firebase.storage {
  match /b/{bucket}/o {

    /* ── helpers ─────────────────────────────────────────────── */

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lab staff custom claims, set by the `inviteLabMember` Cloud Function.
    // Read with a default: most accounts (dentists, suppliers) carry no lab
    // claims at all, and reading a missing property raises an evaluation error
    // rather than returning null.
    function claimLabId() {
      return request.auth.token.get('labId', '');
    }

    function claimRole() {
      return request.auth.token.get('role', '');
    }

    function isLabOwner(labId) {
      return isSignedIn() && uid() == labId;
    }

    function isLabStaff(labId) {
      return isSignedIn()
        && claimLabId() == labId
        && claimRole() in ['ADMIN', 'DESIGNER', 'TECHNICIAN'];
    }

    // Designers and technicians get per-case access, not lab-wide access: the
    // case document's `designerId` is the source of truth, matching the
    // Firestore rule for `lab_orders/{labId}/cases/{caseId}`. Lab ADMINs are
    // exempt so the common path avoids a billed Firestore read.
    function isAssignedStaff(labId, caseId) {
      return isLabStaff(labId) && (
        claimRole() == 'ADMIN'
        || firestore.get(/databases/(default)/documents/lab_orders/$(labId)/cases/$(caseId))
             .data.designerId == uid()
      );
    }

    // Object metadata is likewise absent on legacy uploads, so default it.
    function isCaseDentist() {
      return isSignedIn() && resource.metadata.get('dentistId', '') == uid();
    }

    // Objects are immutable once written: without this an attacker who can
    // create a file can also overwrite someone else's scan (and restamp its
    // metadata to grant themselves read access).
    function isNewObject() {
      return resource == null;
    }

    function hasCaseMetadata(caseId) {
      return request.resource.metadata.get('dentistId', '').size() > 0
        && request.resource.metadata.get('caseId', '') == caseId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    /* ── public catalogue imagery ────────────────────────────── */

    // Product images are shown to signed-out visitors, so read stays open.
    // The path is keyed by productId, so ownership is read from the product
    // doc: any signed-in account could otherwise overwrite another company's
    // images. Uploads for a product that doesn't exist yet (new product form,
    // offer images reuse this prefix with their own id) are still allowed.
    function isStorageAdmin() {
      return isSignedIn() && firestore.get(
        /databases/(default)/documents/user_roles/$(uid())).data.get('role', '') == 'admin';
    }

    // Ownership is proven by the `companyId` stamped into the file's own
    // metadata at upload time, not by looking up the product doc: the doc
    // usually doesn't exist yet when the first image for a brand-new product
    // is uploaded (and ad/offer images reusing this prefix never get one at
    // all), so a `firestore.exists()`/`get()` cross-service lookup here can't
    // distinguish "new product, allow" from "someone else's product, deny".
    match /products/{productId}/{file} {
      allow read: if true;
      // Self-asserted `companyId` metadata alone only proves the uploader
      // controls their own upload, not that they own `productId` — a fresh
      // `crypto.randomUUID()` filename means every upload from the app hits
      // `create`, never `update`, so a metadata-only check here let any
      // signed-in account write into an EXISTING product they don't own.
      // Falling back to the metadata check only when the product doc
      // doesn't exist yet keeps the new-product case working (see the
      // comment above) while closing that off for real products.
      allow create: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && request.resource.metadata.get('companyId', '') == uid()
        && (
          !firestore.exists(/databases/(default)/documents/products/$(productId))
          || firestore.get(/databases/(default)/documents/products/$(productId)).data.companyId == uid()
        );
      allow update: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && resource.metadata.get('companyId', '') == uid()
        && request.resource.metadata.get('companyId', '') == uid();
      allow delete: if isSignedIn() && (
        resource.metadata.get('companyId', '') == uid()
        || isStorageAdmin()
      );
    }

    match /surgical-guides/{ownerId}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == ownerId
        && request.resource.size < 10 * 1024 * 1024
        && isImage();
    }

    // "إعلاناتي" ad images (up to 4 per ad, enforced client-side — rules
    // can't count sibling objects). Public read once approved; the ad's own
    // Firestore doc gates which ones are actually shown.
    match /ads/{ownerId}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == ownerId
        && request.resource.size < 10 * 1024 * 1024
        && isImage();
    }

    /* ── profile imagery ─────────────────────────────────────── */

    // Shown on public profile pages; only the owner may write their own.
    match /avatars/{userId}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == userId
        && request.resource.size < 5 * 1024 * 1024
        && isImage();
    }

    match /profile_pictures/{userId}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == userId
        && request.resource.size < 5 * 1024 * 1024
        && isImage();
    }

    /* ── patient case files (medical data) ───────────────────── */

    // The dentist's scans. Readable by the referring dentist, the lab owner,
    // and only the staff member the case is actually assigned to.
    match /case_scans/{labId}/{caseId}/{file} {
      allow read: if isLabOwner(labId)
        || isCaseDentist()
        || isAssignedStaff(labId, caseId);

      allow create: if isSignedIn()
        && isNewObject()
        && request.resource.size < 60 * 1024 * 1024
        && hasCaseMetadata(caseId)
        && (uid() == request.resource.metadata.get('dentistId', '') || isLabOwner(labId));

      allow update, delete: if isLabOwner(labId);
    }

    // The designer's finished work. Kept in a separate tree from the dentist's
    // scans so that granting design-upload rights can never overwrite or delete
    // the original impression.
    match /case_designs/{labId}/{caseId}/{file} {
      allow read: if isLabOwner(labId)
        || isCaseDentist()
        || isAssignedStaff(labId, caseId);

      allow create: if isNewObject()
        && request.resource.size < 100 * 1024 * 1024
        && hasCaseMetadata(caseId)
        && (isLabOwner(labId) || isAssignedStaff(labId, caseId));

      allow update, delete: if isLabOwner(labId);
    }

    // Lightweight (<=1MB) preview meshes, kept permanently for browsing so the
    // full master file is only fetched when a designer actually opens a case.
    match /previews/{labId}/{caseId}/{file} {
      allow read: if isLabOwner(labId)
        || isCaseDentist()
        || isAssignedStaff(labId, caseId);

      allow create: if isNewObject()
        && request.resource.size < 1024 * 1024
        && hasCaseMetadata(caseId)
        && (uid() == request.resource.metadata.get('dentistId', '')
            || isLabOwner(labId)
            || isAssignedStaff(labId, caseId));

      allow update, delete: if isLabOwner(labId);
    }

    // Rx attachments uploaded from the lab order form. The path carries no
    // labId, so the owning lab is recorded in metadata at write time — and
    // because objects here are immutable, that stamp cannot later be forged by
    // overwriting someone else's file.
    match /orders_files/{orderId}/{file} {
      allow read: if isSignedIn() && (
        uid() == resource.metadata.get('dentistId', '')
        || uid() == resource.metadata.get('labId', '')
        || isLabStaff(resource.metadata.get('labId', ''))
      );

      allow create: if isSignedIn()
        && isNewObject()
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.metadata.get('labId', '').size() > 0
        && uid() == request.resource.metadata.get('dentistId', '');

      allow update, delete: if isSignedIn() && uid() == resource.metadata.get('labId', '');
    }

    // Attachments on the dentist <-> lab case chat. Unlike the scan paths there
    // is no upload metadata to lean on here, so the referring dentist is read
    // from the case document itself.
    match /case_messages/{labId}/{caseId}/{file} {
      function chatDentistId() {
        return firestore
          .get(/databases/(default)/documents/lab_orders/$(labId)/cases/$(caseId))
          .data.dentistId;
      }

      allow read: if isLabOwner(labId)
        || (isSignedIn() && chatDentistId() == uid())
        || isAssignedStaff(labId, caseId);

      allow create: if isNewObject()
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && (isLabOwner(labId)
            || (isSignedIn() && chatDentistId() == uid())
            || isAssignedStaff(labId, caseId));

      allow update, delete: if isLabOwner(labId);
    }
  }
}
