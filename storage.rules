rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ---- PHASE 0: case_scans security hardening ----
    // Uploads must be authenticated, carry dentistId + caseId metadata, and
    // only the referring dentist, the lab owner, or an authorized lab staff
    // member (via custom claims) may write. Reads are equally restricted.
    match /case_scans/{labId}/{caseId}/{file} {
      allow read: if request.auth != null &&
        (request.auth.uid == labId
         || request.auth.uid == resource.metadata.dentistId
         || (request.auth.token.labId == labId
             && request.auth.token.role in ['ADMIN', 'DESIGNER', 'TECHNICIAN']));

      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.metadata.dentistId is string
        && request.resource.metadata.dentistId.size() > 0
        && request.resource.metadata.caseId is string
        && request.resource.metadata.caseId == caseId
        && (request.auth.uid == request.resource.metadata.dentistId
            || request.auth.uid == labId
            || (request.auth.token.labId == labId
                && request.auth.token.role in ['ADMIN', 'DESIGNER', 'TECHNICIAN']));
    }

    // ---- PHASE 4/5: designer output (.stl designs) + preview meshes ----
    // Designers upload completed designs; a lightweight 200KB preview mesh is
    // written alongside the raw master file for rendering + retention.
    match /case_designs/{labId}/{caseId}/{file} {
      allow read: if request.auth != null &&
        (request.auth.uid == labId
         || request.auth.uid == resource.metadata.dentistId
         || (request.auth.token.labId == labId
             && request.auth.token.role in ['ADMIN', 'DESIGNER', 'TECHNICIAN']));

      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.metadata.caseId is string
        && request.resource.metadata.caseId == caseId
        && request.resource.metadata.dentistId is string
        && (request.auth.uid == labId
            || (request.auth.token.labId == labId
                && request.auth.token.role in ['ADMIN', 'DESIGNER']));
    }

    // ---- PHASE 5: preview meshes (kept permanently, ~200KB) ----
    match /previews/{labId}/{caseId}/{file} {
      allow read: if request.auth != null &&
        (request.auth.uid == labId
         || request.auth.uid == resource.metadata.dentistId
         || (request.auth.token.labId == labId
             && request.auth.token.role in ['ADMIN', 'DESIGNER', 'TECHNICIAN']));

      allow write: if request.auth != null
        && request.resource.size < 1024 * 1024
        && request.resource.metadata.caseId is string
        && request.resource.metadata.caseId == caseId
        && request.resource.metadata.dentistId is string
        && (request.auth.uid == labId
            || request.auth.uid == request.resource.metadata.dentistId
            || (request.auth.token.labId == labId
                && request.auth.token.role in ['ADMIN', 'DESIGNER', 'TECHNICIAN']));
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
