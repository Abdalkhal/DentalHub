rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Shared helpers
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Custom claim set by the invite Cloud Function (inviteLabMember).
    // Values: 'ADMIN' | 'DESIGNER' | 'TECHNICIAN' (may be null/absent).
    function staffRole() {
      return request.auth.token.role;
    }

    function claimLabId() {
      return request.auth.token.labId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }

    // The lab owner is the account whose uid equals the lab document id.
    function isLabOwner(labId) {
      return isAuthenticated() && request.auth.uid == labId;
    }

    // Any member of a lab via custom claims (ADMIN, DESIGNER or TECHNICIAN).
    function isLabMember(labId) {
      return isAuthenticated()
        && claimLabId() == labId
        && staffRole() in ['ADMIN', 'DESIGNER', 'TECHNICIAN'];
    }

    function isDesigner(labId) {
      return isLabMember(labId) && staffRole() == 'DESIGNER';
    }

    function isTechnician(labId) {
      return isLabMember(labId) && staffRole() == 'TECHNICIAN';
    }

    function isLabAdmin(labId) {
      return isLabOwner(labId) || (isLabMember(labId) && staffRole() == 'ADMIN');
    }

    function isDentist() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.accountType == 'dentist';
    }

    // Financial fields must never be modified by non-owner staff. This also
    // guards the transition period before financial data is fully migrated to
    // the private/finance subcollection.
    // Read through `get` with a default. The finance migration moved these
    // fields out of the case document into `private/finance`, so on a migrated
    // case they are absent — and indexing a missing key raises an evaluation
    // error, which denied every designer update including harmless ones like
    // advancing `currentStage`.
    function isUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function noFinanceChanges() {
      return isUnchanged('price') && isUnchanged('currency')
        && isUnchanged('unitPrice') && isUnchanged('discount')
        && isUnchanged('pricingMode') && isUnchanged('pricingItems')
        && isUnchanged('subtotalIQD') && isUnchanged('discountAmountIQD')
        && isUnchanged('finalTotalUSD');
    }

    // ============================================================
    // Existing collections
    // ============================================================
    // SECURITY — `role` on this doc is the ONLY thing isAdmin() (and the
    // native app's own "am I admin" check) trusts. The old rule let a user
    // write every field of their own doc with no restriction, `role`
    // included — any signed-in account could set role: 'admin' on itself
    // and instantly pass every admin check in this file. Signup always
    // writes role == accountType (see login.tsx) and never 'admin', so
    // blocking 'admin' on create costs real signups nothing. Real admin
    // status is only ever granted server-side, via the Admin SDK — which
    // these rules don't apply to at all — in createInitialAdmin/setAdminRole
    // (functions/index.js). accountStatus/subscriptionExpiry are similarly
    // admin-controlled business fields (setAccountStatus/extendSubscription),
    // not something the account holder should be able to grant themselves.
    match /user_roles/{userId} {
      allow read: if isAuthenticated();

      // Also blocks a "delete my doc, then create a fresh one" bypass of the
      // update rule below: without this, a suspended account (or one an
      // admin extended a subscription for) could self-delete and recreate
      // its doc to reset accountStatus/subscriptionExpiry, since `create`
      // otherwise has no opinion on them. Real signups (login.tsx) never set
      // either field, so this costs nothing.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role != 'admin'
        && !('accountStatus' in request.resource.data)
        && !('subscriptionExpiry' in request.resource.data);

      // Admins manage OTHER accounts' status/subscription straight from the
      // client (setAccountStatus/extendSubscription in adminPanel.ts), so
      // they need write access to any doc, sensitive fields included — the
      // non-admin branch is what stays restricted to "your own doc, minus
      // the sensitive fields".
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'accountType', 'accountStatus', 'subscriptionExpiry'])
      );

      // Self-delete is how "delete my account" works, but it also let a
      // suspended/expired account delete its doc and recreate it without
      // accountStatus — which reads as "active". Only an active account may
      // delete itself; admins can still remove any account.
      allow delete: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && resource.data.get('accountStatus', 'active') == 'active'
      );
    }

    // Directory copy of each account without its private fields, written only
    // by the syncPublicProfile Cloud Function. Everything that shows OTHER
    // accounts (explore, search, labs, supplies, brands, profiles) reads this.
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // `resource` is null for a brand-new document (create), so the old
      // single rule here — `resource != null && resource.data.companyId ==
      // request.auth.uid` — could never be true on create: every non-admin
      // create was rejected with "Missing or insufficient permissions",
      // for every product type, on both apps. Create is checked against
      // `request.resource` (the incoming data) instead; update/delete stay
      // checked against the existing `resource`, same as before.
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.companyId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource != null && resource.data.companyId == request.auth.uid);

      // Checkout stock decrement: a signed-in dentist may reduce the stock of
      // any product (never below zero and never increase it) so ordered
      // quantities are reflected automatically on both sides. Only the
      // 'stock'/'inStock' fields can be changed here.
      allow update: if isDentist()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.stock
        && request.resource.data.inStock == (request.resource.data.stock > 0);
    }

    match /offers/{offerId} {
      allow read: if true;
      // isAdmin() covers approveAd/deactivateAd (admin.tsx / adminPanel.ts),
      // which moderate ads belonging to OTHER suppliers — without it those
      // writes 403 the moment they're not on your own offer.
      // Create is checked against the incoming supplierId: the old
      // `resource == null` branch let any account publish an offer under
      // another supplier's id. Owners can't hand an offer to someone else.
      allow create: if isAdmin() || (isAuthenticated()
        && request.resource.data.supplierId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated()
        && resource.data.supplierId == request.auth.uid
        && request.resource.data.supplierId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated()
        && resource.data.supplierId == request.auth.uid);
    }

    // General cross-account "إعلاناتي" ads (distinct from `offers`, which is
    // dentist-facing only). Same read/write shape as `offers` — public read
    // (the home banner only ever queries status=='active'), owner or admin
    // write. New ads must start `pending`; only an admin flips that.
    match /ads/{adId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Owners may edit their ad, but only an admin can approve it: the
      // owner may keep the current status or send it back to 'pending'
      // (re-submission), never set 'active' themselves.
      allow update: if isAdmin() || (isAuthenticated()
        && resource.data.accountId == request.auth.uid
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.get('status', null) in
             [resource.data.get('status', null), 'pending']);
      allow delete: if isAdmin() || (isAuthenticated() &&
        resource.data.accountId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.supplierId == request.auth.uid || resource.data.dentistId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.dentistId == request.auth.uid;
      // Either party may update the order, but not re-point who the parties are.
      allow update: if isAuthenticated() &&
        (resource.data.supplierId == request.auth.uid || resource.data.dentistId == request.auth.uid)
        && isUnchanged('dentistId') && isUnchanged('supplierId');
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() &&
        (resource.data.officeId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow create: if isAuthenticated() &&
        (request.resource.data.doctorId == request.auth.uid || request.resource.data.officeId == request.auth.uid);
      allow update: if isAuthenticated() &&
        (resource.data.officeId == request.auth.uid || resource.data.doctorId == request.auth.uid)
        && isUnchanged('officeId') && isUnchanged('doctorId');
      allow delete: if isAdmin();
    }

    match /surgical_guide_companies/{companyId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.companyId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.companyId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Codes are checked at checkout through the lookupPromoCode Cloud
    // Function, which returns only the typed code. Clients may only read
    // their own office's codes, so nobody can list every code.
    match /promo_codes/{codeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.officeId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.officeId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.officeId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /lab_services/{labId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && request.auth.uid == labId;
    }

    match /lab_finances/{labId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == labId;
      allow delete: if isAuthenticated() && request.auth.uid == labId;
    }

    match /admin_config/{config} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // PHASE (catalog): lab custom_catalog
    // Anyone (including dentists opening the Rx form) may read; only the lab
    // owner may write.
    // ============================================================
    match /labs/{labId} {
      match /custom_catalog/{docId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == labId;
      }
    }

    // ============================================================
    // PHASE 5: storage_hashes (SHA-256 dedup bookkeeping)
    // ============================================================
    match /storage_hashes/{hashId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.labId
        || isLabMember(resource.data.labId)
        || resource.data.dentistId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == request.resource.data.labId
        || isLabMember(request.resource.data.labId)
        || request.resource.data.dentistId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.labId
        || isLabMember(resource.data.labId)
        || resource.data.dentistId == request.auth.uid
      );
    }

    // ============================================================
    // PHASE 2: lab_members (real Firebase accounts)
    // ============================================================
    match /lab_members/{memberId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
        || resource.data.labId == request.auth.uid
        || isLabAdmin(resource.data.labId)
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.labId == request.auth.uid
        || isLabAdmin(request.resource.data.labId)
      );
      allow delete: if isAuthenticated() && (
        resource.data.labId == request.auth.uid
        || isLabAdmin(resource.data.labId)
      );
    }

    // A rule scoped to a fixed path (like `/lab_members/{memberId}` above)
    // only authorizes reads/writes made through a normal `collection()`
    // query at that exact path. `useLabMembers` queries via
    // `collectionGroup(db, "lab_members")` (so it isn't tied to one known
    // labId ahead of time) — Firestore requires a SEPARATE rule using the
    // recursive `{path=**}` wildcard to authorize collection-group queries,
    // even when, as here, the collection only ever exists at the root.
    // Without this, the collectionGroup query was rejected outright with
    // "Missing or insufficient permissions" regardless of how correct the
    // rule above was.
    match /{path=**}/lab_members/{memberId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
        || resource.data.labId == request.auth.uid
        || isLabAdmin(resource.data.labId)
      );
    }

    // ============================================================
    // PHASE 0 + 3: lab cases
    // ============================================================
    match /lab_orders/{labId} {
      match /cases/{caseId} {
        // Designers/technicians may only read cases assigned to them — as
        // either the designer or the ceramist (the two independent staff
        // slots set in "طلب جديد"'s "تخصيص الكادر الفني"). Unassigned cases
        // (both fields empty/missing) are invisible to staff.
        allow read: if isAuthenticated() && (
          isLabAdmin(labId)
          || resource.data.dentistId == request.auth.uid
          || (
            isLabMember(labId)
            && (
              resource.data.designerId == request.auth.uid
              || resource.data.ceramistId == request.auth.uid
            )
          )
        );

        // PHASE 0: only the referring dentist or the lab owner may create a case.
        allow create: if isAuthenticated() && (
          request.resource.data.dentistId == request.auth.uid
          || isLabOwner(labId)
        );

        // Staff cannot modify designerId/ceramistId (or any financial field);
        // the owner and the referring dentist keep full update rights.
        allow update: if isAuthenticated() && (
          isLabOwner(labId)
          || (resource.data.dentistId == request.auth.uid && noFinanceChanges())
          || (
            isLabMember(labId)
            && (
              resource.data.designerId == request.auth.uid
              || resource.data.ceramistId == request.auth.uid
            )
            && request.resource.data.designerId == resource.data.designerId
            && request.resource.data.ceramistId == resource.data.ceramistId
            && request.resource.data.dentistId == resource.data.dentistId
            && request.resource.data.caseId == resource.data.caseId
            && noFinanceChanges()
          )
        );

        allow delete: if isLabOwner(labId);

        // ============================================================
        // PHASE 1 + 3: private finance subcollection
        // Only the lab owner (or lab ADMIN) can read/write financial metrics.
        // DESIGNER / TECHNICIAN roles are explicitly denied.
        // ============================================================
        match /private/finance {
          allow read, write: if isLabAdmin(labId);
        }

        // ============================================================
        // Case chat: per-case messages between the referring doctor and the lab.
        // ============================================================
        match /messages/{messageId} {
          allow read: if isAuthenticated() && (
            isLabAdmin(labId)
            || get(/databases/$(database)/documents/lab_orders/$(labId)/cases/$(caseId)).data.dentistId == request.auth.uid
            || (isLabMember(labId) && get(/databases/$(database)/documents/lab_orders/$(labId)/cases/$(caseId)).data.designerId == request.auth.uid)
          );
          allow create: if isAuthenticated()
            && request.resource.data.senderId == request.auth.uid
            && (
              isLabAdmin(labId)
              || isLabMember(labId)
              || get(/databases/$(database)/documents/lab_orders/$(labId)/cases/$(caseId)).data.dentistId == request.auth.uid
            );
          allow update, delete: if isAdmin();
        }
      }
    }

    // The `cases` and `private` rules above are scoped to the fixed path
    // `lab_orders/{labId}/cases/...` — they authorize a lab owner's own
    // `collection(db, "lab_orders", labId, "cases")` query fine, but NOT the
    // `collectionGroup(db, "cases")` / `collectionGroup(db, "private")`
    // queries this app also runs (a dentist listing their own cases across
    // every lab by `dentistId`, a designer listing cases assigned to them by
    // `designerId`, a lab reading its own case-finance docs by `labId`).
    // Firestore requires a separate `{path=**}` rule to authorize
    // collection-group queries even when, as here, the collection never
    // exists anywhere else — without it these queries fail outright with
    // "Missing or insufficient permissions", not a partial/filtered result.
    match /{path=**}/cases/{caseId} {
      allow read: if isAuthenticated() && (
        resource.data.dentistId == request.auth.uid
        || (
          staffRole() in ['ADMIN', 'DESIGNER', 'TECHNICIAN']
          && resource.data.designerId == request.auth.uid
        )
      );
    }

    match /{path=**}/private/{docId} {
      allow read: if isAuthenticated() && resource.data.labId == request.auth.uid;
    }

    // ============================================================
    // Direct messages: 1:1 chat between any two accounts, unrelated to any
    // case/order. Thread id is the two participant uids sorted and joined
    // with "_" (see dmThreadId in the app), so a `create` can verify the id
    // matches the participants without an extra lookup.
    // ============================================================
    match /dm_threads/{threadId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && threadId == (
          request.resource.data.participants[0] < request.resource.data.participants[1]
            ? request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
            : request.resource.data.participants[1] + '_' + request.resource.data.participants[0]
        );

      // Sending a message re-writes the thread doc (merge) to bump
      // lastMessage/lastMessageAt — either participant may do that, but
      // neither may change who the participants are.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participants;
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participants;
        allow update, delete: if isAdmin();
      }
    }

    // ============================================================
    // Deny-by-default for everything else
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
